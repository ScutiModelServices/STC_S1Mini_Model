# Copy to .env.local (run on this device with run.bat), .env.compose (Docker Desktop here: docker compose --env-file .env.compose) or .env (the file Deploy pushes to the deployment device). All git-ignored; .env.local beats .env.

# Empty = no auth (local use only).
SERVICE_ADMIN_PASSWORD=
SERVICE_PORT=29280

# Compose only
SERVICE_REPLICAS=1
# SERVICE_HOST=127.0.0.1
# SERVICE_MEM_LIMIT=3g

# Required. Local run: http://127.0.0.1:11434.
# Start host Ollama; download weights from /admin/ → Updates → Download.
SERVICE_OLLAMA_URL=http://host.docker.internal:11434
SERVICE_OLLAMA_MODEL=s1-mini:f16
SERVICE_OLLAMA_PARALLEL=2

# Local run only: model folder (HF_HOME, OLLAMA_MODELS)
# SERVICE_MODELS_DIR=